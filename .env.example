# =============================================
# nextgen-standup-bot — environment variables
# Copy to .env and adjust.
# =============================================

# --- Bot (Azure Bot Service) ---
MicrosoftAppType=
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=

# --- AI (Groq OpenAI-compatible) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Azure DevOps (used by azureDevopsService) ---
AZURE_ORGANIZATION=
AZURE_PROJECT=
AZURE_PAT=

# --- Standup behavior ---
# Response window for each standup (minutes). A team can
# override via standup_configurations.response_timeout_minutes.
#
# After questions are sent, the bot waits this long (no reminders),)
# then marks unanswered questions NO_RESPONSE and finalizes the standup,
# escalating risks/no-responses when enabled.

STANDUP_TIMEOUT_MINUTES=30

# Cron schedule for scheduled standups (default: weekdays 9:00 AM)
#STANDUP_CRON=0 9 * * 1-5

# API base the orchestrator calls to persist data (the Express server).
#API_BASE_URL=http://localhost:5000