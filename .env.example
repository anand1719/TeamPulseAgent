# =============================================
# nextgen-standup-bot — environment variables
# Copy to .env and adjust.
# =============================================

# --- Bot (Azure Bot Service) ---
MicrosoftAppType=
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=

# --- AI (Groq OpenAI-compatible) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Azure DevOps (used by azureDevopsService) ---
AZURE_ORGANIZATION=
AZURE_PROJECT=
AZURE_PAT=

# --- Linear (used by linearService) ---
# Personal API key from https://linear.app/settings/api (lin_api_...)
LINEAR_API_KEY=

# --- Web chat (TeamPulse Next.js frontend) ---
WEB_CHAT_ORIGINS=http://localhost:3000
API_PORT=5000

# --- Standup behavior ---
# Response window for each standup (minutes). A team can
# override via standup_configurations.response_timeout_minutes.
#
# After questions are sent, the bot waits this long (no reminders),)
# then marks unanswered questions NO_RESPONSE and finalizes the standup,
# escalating risks/no-responses when enabled.

STANDUP_TIMEOUT_MINUTES=30

# Cron schedule for scheduled standups. The standup runs
# ONCE PER DAY, EVENING ONLY, started ONLY by this scheduler
# (never manually / never from the web chat).
# Default: weekdays at 6:00 PM.
#STANDUP_CRON=0 18 * * 1-5

# Question style for the evening standup:
#   EOD     (default) "What did you complete today on <ticket>?"
#   CLASSIC legacy generic standup questions
#STANDUP_QUESTION_MODE=EOD

# Legacy boot-time auto-start (disabled by default - the
# scheduler is the only standup trigger).
#STANDUP_AUTOSTART_ON_BOOT=false

# API base the orchestrator calls to persist data (the Express server).
# It is also the host used by the "Download PDF Report" action on the
# Standup Summary card (<API_BASE_URL>/api/reports/<sessionId>/pdf), so
# in Teams this must be a URL the *client* can reach - a localhost value
# only works in the Bot Framework Emulator.
#API_BASE_URL=http://localhost:5000